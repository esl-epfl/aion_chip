CAPI=2:

# ================================================================
#  Project:     AION
#  Author:      Filippo Quadri <filippo.quadri@epfl.ch>
#  Created:     2026-09-01
#  Description: AION SoC - FuseSoC Core File
# ================================================================

name: epfl:aion:aion:1.0.0
description: AION SoC

filesets:
  rtl:
    files:
      - src/rtl/add.vhd
      - src/rtl/mult.vhd
      - src/rtl/posit_compare.vhd
      - src/rtl/posit_bitwise.vhd
      - src/rtl/posit_alu.vhd
      - src/rtl/aion_soc.vhd
      - src/rtl/aion_interface.vhd
      - src/rtl/tt_um_aion.vhd
    file_type: vhdlSource

  dump_waves:
    files:
      - src/misc/dump_waves.v
    file_type: verilogSource

  tb_py:
    files:
      - src/tb/aion_test.py
    file_type: user

  post_synth_netlist:
    depend:
      - epfl:aion:tech:1.0.0
    files:
      - implementation/synth/nl/tt_um_aion.nl.v
    file_type: verilogSource

  verilator-waivers:
    files:
      - src/misc/aion.vlt
    file_type: vlt

targets:
  default: &default
    filesets:
      - rtl
      - tool_verilator ? (verilator-waivers)
    toplevel: tt_um_aion

  rtl_sim:
    <<: *default
    description: Perform RTL simulation of the AION SoC
    default_tool: icarus
    filesets_append:
      - dump_waves
      - simulation-top
      - tb_py
    tools:
      icarus:
        iverilog_options:
          - -g2012
          - '-s dump_waves'
        vvp_options:
          - -M $(shell cocotb-config --lib-dir)
          - -m $(shell cocotb-config --lib-name vpi icarus)
  
  rtl_sim_ghdl:
    <<: *default
    description: Perform RTL simulation of the AION SoC
    default_tool: ghdl
    filesets_append:
      - tb_py
    tools:
      ghdl:
        analyze_options:
          - -fsynopsys
          - -fexplicit
        run_options:
          - --ieee-asserts=disable
          - --vpi=$(shell cocotb-config --lib-dir)/libcocotbvpi_ghdl.so
          - --wave=../../aion.ghw
          - --fst=../../aion.fst

  rtl_sim_verilator:
    <<: *default
    description: Perform RTL simulation of the AION SoC with Verilator
    default_tool: verilator
    toplevel: tt_um_aion
    filesets_append:
      - tb_py
    tools:
      verilator:
        mode: cc
        verilator_options:
          - '--sv'
          - '--cc'
          - '--trace'
          - '--trace-fst'
          - '--trace-structs'
          - '--trace-params'
          - '--trace-max-array 1024'
          - '--x-assign unique'
          - '--x-initial unique'
          - '--timing'
          - '--vpi'
          - '--prefix Vtop'
          - '-o Vtop'
          - '--public-flat-rw'
          - '-CFLAGS "-Wall -fpermissive"'
          - '-LDFLAGS "-pthread -lutil"'
          - '-LDFLAGS "-Wl,-rpath,$(shell cocotb-config --lib-dir) -L$(shell cocotb-config --lib-dir) -lcocotbvpi_verilator" $(shell cocotb-config --share)/lib/verilator/verilator.cpp'
          - "-Wall"
        make_options:
          - '-j$(shell N=$$(nproc 2>/dev/null || echo 4); [ "$$N" -le 8 ] && echo "$$N" || echo 8)'
        run_options:
          - '--trace'
          - '--trace-file'
          - '../../aion.fst'

  librelane:
    <<: *default
    description: Collect RTL sources for LibreLane physical implementation

  post_synth_sim:
    description: Perform RTL simulation of the AION SoC
    default_tool: verilator
    toplevel: tt_um_aion
    filesets_append:
      - post_synth_netlist
      - tool_icarus ? (dump_waves)
      - tb_py
    tools:
      icarus:
        iverilog_options:
          - -g2012
          - '-s dump_waves'
        vvp_options:
          - -M $(shell cocotb-config --lib-dir)
          - -m $(shell cocotb-config --lib-name vpi icarus)
