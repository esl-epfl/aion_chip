# shellcheck shell=bash

# IHP Microelectronics: ihp-sg13g2
export PDK=ihp-sg13g2
export PDKPATH=$PDK_ROOT/$PDK
export STD_CELL_LIBRARY=sg13g2_stdcell
export SPICE_USERINIT_DIR=$PDKPATH/libs.tech/ngspice
export KLAYOUT_PATH=$PDKPATH/libs.tech/klayout

# Wrap xschem so it always loads the project xschemrc.
# Update the path below to point to this repository root if needed.
xschem() {
    command xschem --rcfile "$(git rev-parse --show-toplevel 2>/dev/null || echo "$DESIGNS/aion_chip")/schematic/xschem/xschemrc" "$@"
}
