CAPI=2:

# ================================================================
#  Project:     AION
#  Author:      Filippo Quadri <filippo.quadri@epfl.ch>
#  Description: Simulation models of the drawn AION standard cells
#
#  GENERATED BY FLOW STEP 6 -- edits here are overwritten by `./flow.py 6`.
# ================================================================

name: epfl:aion:flow_cells:1.0.0
description: |
  Verilog models of the AION cells flow step 6 drew and published.
  Currently: 25 drawn cell(s): AION_a21o_and2_11, AION_a21o_nand3_12, AION_a21o_nor2b_13, AION_a21oi_inv_23, AION_a21oi_nand3b_3, AION_a21oi_nor2_1, AION_a21oi_nor2_22, AION_a21oi_nor4_14, AION_a21oi_o21ai_8, AION_a21oi_or2_9, AION_a22oi_nor2_2, AION_inv_nand2_31, AION_nand2_32, AION_nand2_o21ai_0, AION_nand2_o21ai_12, AION_nand2b_nand3_19, AION_nand2b_o21ai_16, AION_nand2b_o21ai_6, AION_nand3_nor2b_18, AION_nand3_o21ai_17, AION_nor2_33, AION_nor2_o21ai_5, AION_nor2b_o21ai_10, AION_nor3_o21ai_7, AION_o21ai_5.

  The post-PnR netlist instantiates the AION cells as LEAF cells -- LibreLane
  hardens them as macros and the SDF carries one CELL entry per instance -- so
  a post-PnR simulation needs the behavioural model `aion_layout export` solved
  from the transistor netlist, not the structural view in
  3_rewrite/nl/aion_cells.v that step 3's simulation uses.

filesets:
  models:
    files:
      - 6_layout_drawing/AION_a21o_and2_11/final/AION_a21o_and2_11.v
      - 6_layout_drawing/AION_a21o_nand3_12/final/AION_a21o_nand3_12.v
      - 6_layout_drawing/AION_a21o_nor2b_13/final/AION_a21o_nor2b_13.v
      - 6_layout_drawing/AION_a21oi_inv_23/final/AION_a21oi_inv_23.v
      - 6_layout_drawing/AION_a21oi_nand3b_3/final/AION_a21oi_nand3b_3.v
