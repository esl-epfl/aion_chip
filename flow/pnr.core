CAPI=2:

# ================================================================
#  Project:     AION
#  Author:      Filippo Quadri <filippo.quadri@epfl.ch>
#  Created:     2026-09-04
#  Description: Fixed handle on the artifacts of `make pnr`
# ================================================================

name: epfl:aion:flow_pnr:1.0.0
description: |
  output of `make pnr`: hardened from a netlist plus the AI-generated cells

  The directory it points at is wiped and rewritten by every `make pnr`, so
  this core is the stable name the simulation targets in aion.core depend on.
  The files below do not exist until that target has run at least once.

filesets:
  netlist:
    files:
      - pnr/nl/tt_um_aion.nl.v
    file_type: verilogSource

targets:
  default: &default
    filesets:
      - netlist
    toplevel: tt_um_aion
